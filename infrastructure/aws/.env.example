# Copy to infrastructure/aws/.env (never commit).
# Used by Lightsail Compose (`deploy-lightsail.sh` copies this file to /opt/crs)
# and by local jobs (`scripts/run-job.sh`).
#
# Compose only interpolates the ${VARS} referenced in docker-compose.yml.
# Extra keys here (notably ConnectionStrings__DefaultConnection) are for local
# jobs. The API container always talks to Postgres as Host=postgres on the
# Docker network, not this jobs connection string.

# --- shared secrets ---
SQL_ADMIN_USERNAME=crsadmin
DB_PASSWORD=YourStrongPassword123!
OpenAI__ApiKey=sk-your-openai-key
JWT_SECRET=your-very-long-jwt-secret-key-at-least-64-characters-for-security

# X OAuth (API connect flow + x-ingestion)
X__ClientId=
X__ClientSecret=
X__RedirectUri=

# --- Lightsail Compose ---
# Pulled from ECR on crs-lightsail (digest or :latest after docker login).
CRS_API_IMAGE=352126234815.dkr.ecr.us-west-2.amazonaws.com/crs-api:latest

# HTTPS hostname for Caddy + Let's Encrypt (sslip.io works with the static IP).
CRS_API_HOSTNAME=x.x.x.x.sslip.io

# Optional ACME contact email for Caddy.
# CADDY_ACME_EMAIL=you@example.com

# Browser origins allowed to call the API.
CORS_ORIGIN_CLOUDFRONT=https://dxdo3y1dhn04.cloudfront.net
CORS_ORIGIN_S3=http://crs-web-352126234815.s3-website-us-west-2.amazonaws.com

# --- local jobs ---
# scripts/run-job.sh opens an SSH tunnel (127.0.0.1:15432 -> instance 5432) and
# rewrites this connection to that tunnel. Host is used only to find the SSH
# target if CRS_JOBS_SSH_HOST / CRS_API_HOSTNAME are unset. Public 5432 is not
# required. Use --no-tunnel to connect this string as-is.
ConnectionStrings__DefaultConnection=Host=<crs-lightsail-ip>;Database=crsdb;Username=crsadmin;Password=YourStrongPassword123!
# Optional SSH overrides:
# CRS_JOBS_SSH_HOST=<crs-lightsail-ip>
# CRS_JOBS_SSH_USER=ubuntu
# CRS_JOBS_SSH_KEY=~/.ssh/crs-lightsail-key.pem
# CRS_JOBS_TUNNEL_LOCAL_PORT=15432
# CRS_JOBS_SSH_TUNNEL=0
