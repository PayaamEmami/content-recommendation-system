# CRS Secrets Configuration
# Copy this file to secrets.env and fill in the values.
# NEVER commit secrets.env to git!
#
# Used by local jobs (`scripts/run-job.sh`) and as a bootstrap reference for Lightsail .env.

# Database username/password
SQL_ADMIN_USERNAME=crsadmin
DB_PASSWORD=YourStrongPassword123!

# OpenAI API Key (https://platform.openai.com/api-keys)
OpenAI__ApiKey=sk-your-openai-key

# JWT Secret (64+ characters - generate with: openssl rand -base64 64)
JWT_SECRET=your-very-long-jwt-secret-key-at-least-64-characters-for-security

# X OAuth (required for x-ingestion; same Client ID/Secret as the Lightsail API)
X__ClientId=
X__ClientSecret=
X__RedirectUri=

# Point local jobs at Lightsail Postgres + OpenSearch
ConnectionStrings__DefaultConnection=Host=<crs-lightsail-ip>;Database=crsdb;Username=crsadmin;Password=YourStrongPassword123!
OpenSearch__Mode=Local
OpenSearch__Endpoint=http://<crs-lightsail-ip>:9200
