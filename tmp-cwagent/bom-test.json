{
  "agent": {
    "region": "us-west-2",
    "logfile": "C:\\ProgramData\\Amazon\\AmazonCloudWatchAgent\\Logs\\amazon-cloudwatch-agent.log",
    "debug": false
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "C:\\ProgramData\\CRS\\observability\\jobs\\*\\*.jsonl",
            "log_group_name": "/crs/local-jobs",
            "log_stream_name": "{hostname}",
            "timezone": "UTC",
            "retention_in_days": 30
          }
        ]
      },
      "windows_events": {
        "collect_list": [
          {
            "event_name": "Application",
            "event_levels": [
              "ERROR",
              "WARNING"
            ],
            "log_group_name": "/crs/windows-host",
            "log_stream_name": "{hostname}/application"
          },
          {
            "event_name": "System",
            "event_levels": [
              "ERROR",
              "WARNING"
            ],
            "log_group_name": "/crs/windows-host",
            "log_stream_name": "{hostname}/system"
          }
        ]
      }
    },
    "force_flush_interval": 5
  },
  "metrics": {
    "namespace": "CRS/Host",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "ImageId": "${aws:ImageId}",
      "InstanceType": "${aws:InstanceType}",
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "host": "${hostname}"
    },
    "metrics_collected": {
      "LogicalDisk": {
        "measurement": [
          "% Free Space"
        ],
        "resources": [
          "*"
        ]
      },
      "Memory": {
        "measurement": [
          "% Committed Bytes In Use"
        ]
      },
      "Processor": {
        "measurement": [
          "% Processor Time"
        ],
        "resources": [
          "_Total"
        ]
      }
    }
  },
  "traces": {
    "traces_collected": {
      "otlp": {
        "grpc_endpoint": "127.0.0.1:4317",
        "http_endpoint": "127.0.0.1:4318"
      }
    }
  }
}
