{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Observability": {
    "ExecutionEnvironment": "aws",
    "ServiceNamespace": "crs",
    "TraceSampleRatio": 0.2,
    "MetricsNamespace": "CRS/Application",
    "EnableSensitiveBodyLogging": false
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Embedding": {
    "ModelName": "text-embedding-3-small",
    "Dimensions": 1536,
    "MaxBatchSize": 100
  },
  "OpenSearch": {
    "Mode": "Aws",
    "Endpoint": "",
    "IndexName": "crs-content",
    "EmbeddingDimensions": 1536
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "Crs.Api",
    "Audience": "Crs.Web",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownNetworks": [
      "10.1.0.0/16"
    ]
  },
  "Registration": {
    "Enabled": false,
    "DisabledMessage": "New account registrations are currently closed. Please check back later."
  }
}
