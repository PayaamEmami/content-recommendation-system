{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Crs": "Debug"
    }
  },
  "Observability": {
    "ServiceNamespace": "crs",
    "TraceSampleRatio": 1.0,
    "MetricsNamespace": "CRS/Application",
    "EnableSensitiveBodyLogging": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=crsdb;Username=crsadmin;Password=your-password"
  },
  "Embedding": {
    "ModelName": "text-embedding-3-small",
    "Dimensions": 1536,
    "MaxBatchSize": 100
  },
  "OpenSearch": {
    "Mode": "Aws",
    "Endpoint": "https://your-opensearch-endpoint.us-west-2.aoss.amazonaws.com",
    "IndexName": "crs-content",
    "EmbeddingDimensions": 1536
  },
  "OpenAI": {
    "ApiKey": "your-openai-api-key",
    "Model": "gpt-5-nano",
    "MaxTokens": 16384,
    "Temperature": 0
  }
}

