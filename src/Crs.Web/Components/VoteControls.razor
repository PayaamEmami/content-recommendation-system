@using Crs.Core.Enums

<div class="@CssClass" aria-label="@AriaLabel">
    @if (!string.IsNullOrWhiteSpace(ScreenReaderText))
    {
        <span class="sr-only">@ScreenReaderText</span>
    }

    <button type="button"
            class="vote-btn vote-up @(CurrentVote == VoteType.Upvote ? "active" : "")"
            @onclick="() => OnVote.InvokeAsync(VoteType.Upvote)"
            disabled="@Disabled"
            tabindex="@TabIndex"
            aria-hidden="@HideFromAssistiveTech"
            aria-label="Upvote content"
            aria-busy="@IsSyncing"
            title="Upvote">
        <UiSvgIcon Kind="SvgIconKind.ArrowUp" Class="vote-icon" />
    </button>
    <button type="button"
            class="vote-btn vote-down @(CurrentVote == VoteType.Downvote ? "active" : "")"
            @onclick="() => OnVote.InvokeAsync(VoteType.Downvote)"
            disabled="@Disabled"
            tabindex="@TabIndex"
            aria-hidden="@HideFromAssistiveTech"
            aria-label="Downvote content"
            aria-busy="@IsSyncing"
            title="Downvote">
        <UiSvgIcon Kind="SvgIconKind.ArrowDown" Class="vote-icon" />
    </button>
</div>

@code {
    [Parameter] public VoteType? CurrentVote { get; set; }
    [Parameter] public EventCallback<VoteType> OnVote { get; set; }
    [Parameter] public bool IsSyncing { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool HideFromAssistiveTech { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Content feedback";
    [Parameter] public string? ScreenReaderText { get; set; }
    [Parameter] public string? Class { get; set; }

    private int? TabIndex => HideFromAssistiveTech ? -1 : null;

    private string CssClass => string.Join(" ", new[] { "content-vote-controls", Disabled ? "readonly" : null, Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));
}

