@typeparam TValue
@inject IJSRuntime JSRuntime

<div @ref="_root" class="@CssClass" @onfocusout="CloseOnFocusOutAsync" @onkeydown="HandleKeyDown">
    <button type="button"
            id="@Id"
            class="ui-select-trigger"
            @onclick="ToggleOpen"
            aria-expanded="@_isOpen"
            aria-haspopup="listbox"
            disabled="@Disabled">
        <span class="@SelectedLabelClass">@SelectedLabel</span>
        <UiSvgIcon Kind="SvgIconKind.ChevronDown" Class="ui-select-chevron" />
    </button>

    @if (_isOpen)
    {
        <div class="ui-select-menu" role="listbox">
            @foreach (var option in Options)
            {
                @* preventDefault keeps focus on the trigger so focusout does not unmount the menu before click. *@
                <button type="button"
                        class="@GetOptionClass(option)"
                        role="option"
                        aria-selected="@IsSelected(option)"
                        @key="option.Value"
                        @onmousedown:preventDefault="true"
                        @onclick="() => SelectOption(option)">
                    @option.Label
                </button>
            }
        </div>
    }
</div>

@code {
    private bool _isOpen;
    private ElementReference _root;

    [Parameter] public IReadOnlyList<UiSelectOption<TValue>> Options { get; set; } = Array.Empty<UiSelectOption<TValue>>();
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select...";
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private string CssClass => string.Join(" ", new[] { "ui-select", Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    private UiSelectOption<TValue>? SelectedOption => Options.FirstOrDefault(IsSelected);

    private string SelectedLabel => SelectedOption?.Label ?? Placeholder;

    private string SelectedLabelClass => SelectedOption is null ? "ui-select-placeholder" : string.Empty;

    private void ToggleOpen()
    {
        if (!Disabled)
        {
            _isOpen = !_isOpen;
        }
    }

    private async Task SelectOption(UiSelectOption<TValue> option)
    {
        _isOpen = false;
        await ValueChanged.InvokeAsync(option.Value);
    }

    private async Task CloseOnFocusOutAsync()
    {
        if (!_isOpen)
        {
            return;
        }

        // focusout bubbles from the trigger when focus moves to an option. Wait a
        // tick, then close only if focus has actually left the control.
        await Task.Yield();

        var hasFocusWithin = await JSRuntime.InvokeAsync<bool>("hasFocusWithin", _root);
        if (!hasFocusWithin)
        {
            _isOpen = false;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _isOpen = false;
        }
    }

    private bool IsSelected(UiSelectOption<TValue> option)
    {
        return EqualityComparer<TValue>.Default.Equals(Value, option.Value);
    }

    private string GetOptionClass(UiSelectOption<TValue> option)
    {
        return IsSelected(option) ? "ui-select-option selected" : "ui-select-option";
    }
}
