@inject SourceService SourceService
@inject ToastService ToastService

<div class="import-export-form">
    <p class="bulk-hint">Download your current sources as a JSON file you can keep or import later.</p>

    @if (!HasLoadedSources && !string.IsNullOrEmpty(LoadError))
    {
        <AlertMessage Variant="AlertVariant.Error">Can't export until your sources load successfully. @LoadError</AlertMessage>
    }

    <button type="button" @onclick="HandleExport" class="btn-primary" disabled="@(!CanExport)">
        @(_isExporting ? "Exporting..." : "Export")
    </button>
</div>

@code {
    [Parameter] public List<SourceItem>? Sources { get; set; }
    [Parameter] public string? LoadError { get; set; }

    private bool _isExporting;

    private bool HasLoadedSources => Sources != null && Sources.Count > 0;
    private bool CanExport => !_isExporting && HasLoadedSources;

    private async Task HandleExport()
    {
        if (!HasLoadedSources || Sources == null)
        {
            return;
        }

        _isExporting = true;

        try
        {
            await SourceService.ExportSourcesAsync(Sources);
            ToastService.Show($"Exported {Sources.Count} source(s)");
        }
        finally
        {
            _isExporting = false;
        }
    }
}
