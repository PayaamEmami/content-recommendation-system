<div class="@CssClass" role="@Role">
    @ChildContent
</div>

@code {
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Info;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    private string CssClass => string.Join(" ", new[]
    {
        "alert-message",
        $"alert-message-{Variant.ToString().ToLowerInvariant()}",
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string Role => Variant == AlertVariant.Error ? "alert" : "status";
}

