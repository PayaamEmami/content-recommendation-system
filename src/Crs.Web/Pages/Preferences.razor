@page "/preferences"
@page "/sources"
@page "/history"
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Preferences - CRS</PageTitle>

<div class="page-container preferences-page settings-page">
    <UiPageHeader Title="Preferences" Class="compact-page-header" />
    <div class="settings-page-divider"></div>

    <section class="preferences-section">
        <UiSectionHeader Class="preferences-section-header" Title="Sources" />
        <div class="preferences-section-body">
            <SourcesSection />
        </div>
    </section>

    <section class="preferences-section">
        <UiSectionHeader Class="preferences-section-header" Title="Training examples" />
        <div class="preferences-section-body">
            <TrainingExamplesSection />
        </div>
    </section>

    <section class="preferences-section">
        <VotingHistorySection />
    </section>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.EnsureAuthenticatedAsync())
        {
            Navigation.NavigateTo("/");
        }
    }
}
