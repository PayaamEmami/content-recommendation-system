@page "/preferences"
@using Crs.Core.Enums
@inject AuthService AuthService
@inject FeedService FeedService
@inject PreferencesService PreferencesService
@inject ThemeService ThemeService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Preferences - CRS</PageTitle>

<div class="page-container preferences-page">
    <section class="preferences-section">
        <div class="preferences-section-header">
            <h2>Settings</h2>
        </div>

        <div class="preferences-section-body">
            <div class="preferences-setting-row">
                <div class="preferences-setting-copy">
                    <h3>Theme</h3>
                    <p>Choose how the app should look while you browse your feeds and manage content.</p>
                </div>
                <div class="theme-options">
                    <button class="@(ThemeService.IsDarkMode ? "btn-primary" : "btn-secondary")" @onclick="() => SetThemeAsync(true)">
                        Dark
                    </button>
                    <button class="@(!ThemeService.IsDarkMode ? "btn-primary" : "btn-secondary")" @onclick="() => SetThemeAsync(false)">
                        Light
                    </button>
                </div>
            </div>
        </div>
    </section>

    <section class="preferences-section">
        <div class="preferences-section-header">
            <h2>Content</h2>
        </div>

        <div class="preferences-section-body">
            <div class="preferences-content-grid">
                <div class="add-source-panel preferences-form-panel">
                    <div class="preferences-panel-heading">
                        <h3>@(_editingContentId.HasValue ? "Edit Content Example" : "Add Content Examples")</h3>
                        <p>Add specific content examples to give the recommendation system more signal.</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="error-message">@_errorMessage</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_successMessage))
                    {
                        <div class="success-message">@_successMessage</div>
                    }

                    <div class="add-source-form">
                        <EditForm Model="_formModel" OnValidSubmit="HandleSubmitAsync">
                            <DataAnnotationsValidator />
                            <div class="form-grid">
                                <div class="form-group form-group-wide">
                                    <label for="content-title">Title</label>
                                    <InputText id="content-title" @bind-Value="_formModel.Title" class="form-input" placeholder="e.g. Distill article on transformers" />
                                    <ValidationMessage For="@(() => _formModel.Title)" />
                                </div>

                                <div class="form-group">
                                    <label for="content-type">Content Type <span class="optional">(optional)</span></label>
                                    <InputSelect id="content-type" @bind-Value="_formModel.ContentType" class="form-input">
                                        <option value="">Select...</option>
                                        @foreach (var type in Enum.GetValues<ContentType>())
                                        {
                                            <option value="@type">@GetContentTypeDisplay(type)</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="form-group">
                                    <label for="content-vote">Feedback</label>
                                    <InputSelect id="content-vote" @bind-Value="_formModel.VoteType" class="form-input">
                                        <option value="@VoteType.Upvote">Upvote</option>
                                        <option value="@VoteType.Downvote">Downvote</option>
                                    </InputSelect>
                                </div>

                                <div class="form-group form-group-wide">
                                    <label for="content-url">URL <span class="optional">(optional)</span></label>
                                    <InputText id="content-url" @bind-Value="_formModel.Url" class="form-input" placeholder="https://example.com/article" />
                                    <ValidationMessage For="@(() => _formModel.Url)" />
                                </div>

                                <div class="form-group form-group-wide">
                                    <label for="content-description">Description <span class="optional">(optional)</span></label>
                                    <InputTextArea id="content-description" @bind-Value="_formModel.Description" class="form-input preferences-textarea" placeholder="What about this content did you like or dislike?" />
                                    <ValidationMessage For="@(() => _formModel.Description)" />
                                </div>
                            </div>

                            <div class="preferences-form-actions">
                                <button type="submit" class="btn-primary" disabled="@_isSaving">
                                    @(_isSaving ? "Saving..." : _editingContentId.HasValue ? "Save Changes" : "Add Content")
                                </button>
                                @if (_editingContentId.HasValue)
                                {
                                    <button type="button" class="btn-secondary" @onclick="ResetForm" disabled="@_isSaving">Cancel</button>
                                }
                            </div>
                        </EditForm>
                    </div>
                </div>

                <div class="preferences-saved-panel">
                    <div class="preferences-list-header">
                        <h3>Saved Content</h3>
                        <span class="preferences-count">@_content.Count item@(_content.Count == 1 ? "" : "s")</span>
                    </div>

                    @if (_isLoading)
                    {
                        <div class="feed-loading-state" role="status" aria-live="polite">
                            <div class="feed-loading-spinner" aria-hidden="true"></div>
                            <div class="feed-loading-copy">
                                <span class="feed-loading-title">Loading saved content</span>
                                <span class="feed-loading-subtitle">Gathering the examples you have already rated so you can review them here.</span>
                            </div>
                        </div>
                    }
                    else if (!_content.Any())
                    {
                        <div class="empty-state">
                            <h3>No content yet</h3>
                            <p>Save a few examples here to help the recommendation system learn your taste.</p>
                        </div>
                    }
                    else
                    {
                        <div class="preferences-list">
                            @foreach (var content in _content)
                            {
                                <div class="preference-row">
                                    <div class="preference-vote @GetVoteCss(content.VoteType)">
                                        @(content.VoteType == VoteType.Upvote ? "Upvote" : "Downvote")
                                    </div>
                                    <div class="preference-content">
                                        <div class="preference-meta">
                                            @if (content.ContentType.HasValue)
                                            {
                                                <span class="content-type-badge">@GetContentTypeDisplay(content.ContentType.Value)</span>
                                            }
                                            <span class="content-date">@FormatDate(content.UpdatedAt)</span>
                                        </div>
                                        <h3 class="content-row-title">
                                            @if (!string.IsNullOrWhiteSpace(content.Url))
                                            {
                                                <a href="@content.Url" target="_blank" rel="noopener">@content.Title</a>
                                            }
                                            else
                                            {
                                                <span>@content.Title</span>
                                            }
                                        </h3>
                                        @if (!string.IsNullOrWhiteSpace(content.Description))
                                        {
                                            <p class="content-row-description">@content.Description</p>
                                        }
                                    </div>
                                    <div class="preference-actions">
                                        <button class="action-btn" @onclick="() => StartEdit(content)" disabled="@_isSaving" title="Edit">Edit</button>
                                        <button class="action-btn danger-text" @onclick="() => DeleteContentAsync(content.Id)" disabled="@_isSaving" title="Delete">Delete</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="preferences-section">
        <div class="preferences-section-header preferences-history-section-header">
            <div>
                <h2>Voting History</h2>
                <p class="preferences-section-subtitle">Review the recommendation content you have voted on and adjust those votes with the same controls used in the feed.</p>
            </div>
            <div class="preferences-history-filter-shell">
                <button class="preferences-filter-btn"
                        type="button"
                        @onclick="ToggleVoteHistoryFilters"
                        aria-label="Filter voting history"
                        aria-expanded="@_showVoteHistoryFilters"
                        title="@($"Filter voting history: {GetVoteHistoryFilterLabel(_activeVoteHistoryFilter)}")">
                    <UiSvgIcon Kind="SvgIconKind.Filter" Class="preferences-filter-icon" />
                </button>

                @if (_showVoteHistoryFilters)
                {
                    <div class="preferences-filter-menu" role="menu" aria-label="Voting history filter">
                        @foreach (var filter in Enum.GetValues<VoteHistoryFilter>())
                        {
                            <button class="preferences-filter-option @(_activeVoteHistoryFilter == filter ? "active" : "")"
                                    type="button"
                                    @onclick="() => SetVoteHistoryFilter(filter)">
                                @GetVoteHistoryFilterLabel(filter)
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="preferences-section-body">
            <div class="preferences-history-panel">
                @{
                    var visibleVoteHistory = GetVisibleVoteHistory();
                }
                <div class="preferences-list-header">
                    <h3>@GetVoteHistoryFilterHeading()</h3>
                    <span class="preferences-count">@visibleVoteHistory.Count item@(visibleVoteHistory.Count == 1 ? "" : "s")</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(_voteHistoryError))
                {
                    <div class="error-message">@_voteHistoryError</div>
                }

                @if (_isVoteHistoryLoading)
                {
                    <div class="feed-loading-state" role="status" aria-live="polite">
                        <div class="feed-loading-spinner" aria-hidden="true"></div>
                        <div class="feed-loading-copy">
                            <span class="feed-loading-title">Loading voting history</span>
                            <span class="feed-loading-subtitle">Pulling in the content you have voted on so you can review it here.</span>
                        </div>
                    </div>
                }
                else if (!visibleVoteHistory.Any())
                {
                    <div class="empty-state">
                        <h3>No voting history yet</h3>
                        <p>@GetVoteHistoryEmptyMessage()</p>
                    </div>
                }
                else
                {
                    <div class="content-table preferences-history-list themed-scrollbar">
                        @foreach (var content in visibleVoteHistory)
                        {
                            <div class="content-row preferences-history-row @(content.VoteType is null ? "vote-cleared" : string.Empty)">
                                <div class="content-vote-controls">
                                    <button class="vote-btn vote-up @(content.VoteType == VoteType.Upvote ? "active" : "")"
                                            @onclick="() => HandleVoteHistoryVote(content.ContentId, VoteType.Upvote)"
                                            aria-label="Upvote content"
                                            aria-busy="@_syncingVoteHistoryContentIds.Contains(content.ContentId)"
                                            title="Upvote">
                                        <span class="vote-icon">&#9650;</span>
                                    </button>
                                    <button class="vote-btn vote-down @(content.VoteType == VoteType.Downvote ? "active" : "")"
                                            @onclick="() => HandleVoteHistoryVote(content.ContentId, VoteType.Downvote)"
                                            aria-label="Downvote content"
                                            aria-busy="@_syncingVoteHistoryContentIds.Contains(content.ContentId)"
                                            title="Downvote">
                                        <span class="vote-icon">&#9660;</span>
                                    </button>
                                </div>
                                <div class="content-content">
                                    <div class="content-meta">
                                        <span class="content-type-badge">@GetContentTypeDisplay(content.Type)</span>
                                        @if (content.VoteType is null)
                                        {
                                            <span class="preferences-cleared-badge">Vote cleared</span>
                                        }
                                    </div>
                                    <h3 class="content-row-title">
                                        <a href="@content.Url" target="_blank" rel="noopener">@content.Title</a>
                                        <span class="content-date">@FormatDate(content.ContentDate)</span>
                                    </h3>
                                    @if (!string.IsNullOrWhiteSpace(content.Description))
                                    {
                                        <p class="content-row-description">@content.Description</p>
                                    }
                                </div>
                                <div class="content-actions">
                                    <a href="@content.Url" target="_blank" rel="noopener" class="content-open-btn" title="Open content">
                                        &#8599;
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@code {
    private readonly List<PreferenceItem> _content = new();
    private readonly List<VoteHistoryItem> _voteHistory = new();
    private readonly Dictionary<Guid, VoteType> _serverVoteHistoryStates = new();
    private readonly HashSet<Guid> _syncingVoteHistoryContentIds = new();
    private readonly Dictionary<Guid, VoteType?> _desiredVoteHistoryStates = new();
    private readonly Dictionary<Guid, DateTime> _lastVoteHistoryActionAt = new();
    private readonly HashSet<Guid> _sessionClearedVoteHistoryContentIds = new();
    private static readonly TimeSpan VoteHistoryActionDebounceWindow = TimeSpan.FromMilliseconds(400);
    private ContentFormModel _formModel = new();
    private Guid? _editingContentId;
    private bool _isLoading = true;
    private bool _isVoteHistoryLoading = true;
    private bool _isSaving;
    private bool _showVoteHistoryFilters;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _voteHistoryError;
    private VoteHistoryFilter _activeVoteHistoryFilter = VoteHistoryFilter.All;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            ThemeService.OnThemeChanged += StateHasChanged;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.EnsureAuthenticatedAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPageDataAsync();
    }

    private async Task LoadPageDataAsync()
    {
        await Task.WhenAll(LoadContentAsync(), LoadVoteHistoryAsync());
    }

    private async Task LoadContentAsync()
    {
        _isLoading = true;
        _content.Clear();
        _content.AddRange(await PreferencesService.GetPreferencesAsync());
        _isLoading = false;
    }

    private async Task LoadVoteHistoryAsync()
    {
        _isVoteHistoryLoading = true;
        _voteHistoryError = null;
        _showVoteHistoryFilters = false;
        _voteHistory.Clear();
        _serverVoteHistoryStates.Clear();
        _desiredVoteHistoryStates.Clear();
        _syncingVoteHistoryContentIds.Clear();
        _lastVoteHistoryActionAt.Clear();
        _sessionClearedVoteHistoryContentIds.Clear();

        var history = await FeedService.GetVoteHistoryAsync();
        foreach (var item in history.OrderByDescending(GetVoteHistorySortDate))
        {
            _voteHistory.Add(item);
            if (item.VoteType is { } voteType)
            {
                _serverVoteHistoryStates[item.ContentId] = voteType;
            }
        }

        _isVoteHistoryLoading = false;
    }

    private async Task HandleSubmitAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;
        var wasEditing = _editingContentId.HasValue;

        var request = new PreferenceUpsertRequest
        {
            Title = _formModel.Title,
            Description = _formModel.Description,
            Url = _formModel.Url,
            ContentType = _formModel.ContentType,
            VoteType = _formModel.VoteType
        };

        PreferenceItem? savedContent = wasEditing
            ? await PreferencesService.UpdatePreferenceAsync(_editingContentId!.Value, request)
            : await PreferencesService.CreatePreferenceAsync(request);

        if (savedContent == null)
        {
            _errorMessage = "We couldn't save that content. Please try again.";
            _isSaving = false;
            return;
        }

        await LoadContentAsync();
        ResetForm();
        _successMessage = wasEditing ? "Content updated." : "Content added.";
        _isSaving = false;
    }

    private void StartEdit(PreferenceItem content)
    {
        _editingContentId = content.Id;
        _errorMessage = null;
        _successMessage = null;
        _formModel = new ContentFormModel
        {
            Title = content.Title,
            Description = content.Description,
            Url = content.Url,
            ContentType = content.ContentType,
            VoteType = content.VoteType
        };
    }

    private async Task DeleteContentAsync(Guid contentId)
    {
        _errorMessage = null;
        _successMessage = null;

        var deleted = await PreferencesService.DeletePreferenceAsync(contentId);
        if (!deleted)
        {
            _errorMessage = "We couldn't delete that content. Please try again.";
            return;
        }

        if (_editingContentId == contentId)
        {
            ResetForm();
        }

        await LoadContentAsync();
        _successMessage = "Content deleted.";
    }

    private async Task SetThemeAsync(bool isDarkMode)
    {
        await ThemeService.SetThemeAsync(isDarkMode);
    }

    private void ToggleVoteHistoryFilters()
    {
        _showVoteHistoryFilters = !_showVoteHistoryFilters;
    }

    private void SetVoteHistoryFilter(VoteHistoryFilter filter)
    {
        _activeVoteHistoryFilter = filter;
        _showVoteHistoryFilters = false;
    }

    private Task HandleVoteHistoryVote(Guid contentId, VoteType voteType)
    {
        if (_lastVoteHistoryActionAt.TryGetValue(contentId, out var lastActionAt) &&
            DateTime.UtcNow - lastActionAt < VoteHistoryActionDebounceWindow)
        {
            return Task.CompletedTask;
        }

        var historyItem = _voteHistory.FirstOrDefault(item => item.ContentId == contentId);
        if (historyItem == null)
        {
            return Task.CompletedTask;
        }

        _voteHistoryError = null;
        _lastVoteHistoryActionAt[contentId] = DateTime.UtcNow;

        var currentVote = historyItem.VoteType;
        VoteType? nextVote = currentVote == voteType ? null : voteType;

        historyItem.VoteType = nextVote;
        if (nextVote is null)
        {
            _sessionClearedVoteHistoryContentIds.Add(contentId);
        }
        else
        {
            _sessionClearedVoteHistoryContentIds.Remove(contentId);
        }

        _desiredVoteHistoryStates[contentId] = nextVote;

        if (!_syncingVoteHistoryContentIds.Contains(contentId))
        {
            _ = SyncVoteHistoryStateAsync(contentId);
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SyncVoteHistoryStateAsync(Guid contentId)
    {
        _syncingVoteHistoryContentIds.Add(contentId);

        try
        {
            while (_desiredVoteHistoryStates.TryGetValue(contentId, out var desiredVoteState))
            {
                var previousServerVoteState = _serverVoteHistoryStates.TryGetValue(contentId, out var serverVote)
                    ? serverVote
                    : (VoteType?)null;

                var succeeded = await PersistVoteHistoryStateAsync(contentId, desiredVoteState);
                if (!succeeded)
                {
                    ApplyVoteHistoryState(contentId, previousServerVoteState);
                    _desiredVoteHistoryStates[contentId] = previousServerVoteState;
                    _voteHistoryError = "We couldn't update that vote. Please try again.";
                    break;
                }

                if (desiredVoteState is { } persistedVote)
                {
                    _serverVoteHistoryStates[contentId] = persistedVote;
                    _sessionClearedVoteHistoryContentIds.Remove(contentId);
                }
                else
                {
                    _serverVoteHistoryStates.Remove(contentId);
                    _sessionClearedVoteHistoryContentIds.Add(contentId);
                }

                if (_desiredVoteHistoryStates.TryGetValue(contentId, out var latestDesiredState) &&
                    latestDesiredState == desiredVoteState)
                {
                    _desiredVoteHistoryStates.Remove(contentId);
                }
            }
        }
        finally
        {
            _syncingVoteHistoryContentIds.Remove(contentId);
            StateHasChanged();
        }
    }

    private async Task<bool> PersistVoteHistoryStateAsync(Guid contentId, VoteType? desiredVoteState)
    {
        var historyItem = _voteHistory.FirstOrDefault(item => item.ContentId == contentId);
        if (historyItem == null)
        {
            return false;
        }

        if (desiredVoteState is null)
        {
            return await FeedService.RemoveVoteAsync(contentId);
        }

        var result = await FeedService.VoteAsync(contentId, desiredVoteState.Value);
        if (result == null)
        {
            return false;
        }

        if (_desiredVoteHistoryStates.TryGetValue(contentId, out var latestDesiredState) && latestDesiredState == desiredVoteState)
        {
            historyItem.VoteType = result.VoteType;
            historyItem.VoteCreatedAt = result.CreatedAt;
            historyItem.VoteUpdatedAt = result.UpdatedAt;
        }

        return true;
    }

    private void ApplyVoteHistoryState(Guid contentId, VoteType? voteState)
    {
        var historyItem = _voteHistory.FirstOrDefault(item => item.ContentId == contentId);
        if (historyItem == null)
        {
            return;
        }

        historyItem.VoteType = voteState;
        if (voteState is null)
        {
            _sessionClearedVoteHistoryContentIds.Add(contentId);
            return;
        }

        _sessionClearedVoteHistoryContentIds.Remove(contentId);
    }

    private void ResetForm()
    {
        _editingContentId = null;
        _formModel = new ContentFormModel();
    }

    private static string GetContentTypeDisplay(ContentType type) => type switch
    {
        ContentType.BlogPost => "Blog Post",
        _ => type.ToString()
    };

    private static string GetVoteCss(VoteType voteType) => voteType == VoteType.Upvote ? "vote-up" : "vote-down";

    private List<VoteHistoryItem> GetVisibleVoteHistory()
    {
        return _voteHistory
            .Where(ShouldShowVoteHistoryItem)
            .OrderByDescending(GetVoteHistorySortDate)
            .ToList();
    }

    private bool ShouldShowVoteHistoryItem(VoteHistoryItem item)
    {
        if (item.VoteType is null)
        {
            return _sessionClearedVoteHistoryContentIds.Contains(item.ContentId);
        }

        return _activeVoteHistoryFilter switch
        {
            VoteHistoryFilter.Upvoted => item.VoteType == VoteType.Upvote,
            VoteHistoryFilter.Downvoted => item.VoteType == VoteType.Downvote,
            _ => true
        };
    }

    private string GetVoteHistoryFilterHeading()
    {
        return _activeVoteHistoryFilter switch
        {
            VoteHistoryFilter.Upvoted => "Upvoted Content",
            VoteHistoryFilter.Downvoted => "Downvoted Content",
            _ => "All Voted Content"
        };
    }

    private string GetVoteHistoryEmptyMessage()
    {
        return _activeVoteHistoryFilter switch
        {
            VoteHistoryFilter.Upvoted => "You have not upvoted any recommendation content yet.",
            VoteHistoryFilter.Downvoted => "You have not downvoted any recommendation content yet.",
            _ => "Vote on recommendation content in your feed and it will show up here."
        };
    }

    private static string GetVoteHistoryFilterLabel(VoteHistoryFilter filter)
    {
        return filter switch
        {
            VoteHistoryFilter.Upvoted => "Upvoted",
            VoteHistoryFilter.Downvoted => "Downvoted",
            _ => "All"
        };
    }

    private static DateTime GetVoteHistorySortDate(VoteHistoryItem item)
    {
        return item.VoteUpdatedAt ?? item.VoteCreatedAt;
    }

    private static string FormatDate(DateTime dateTime)
    {
        var local = dateTime.ToLocalTime();
        return local.ToString("MMM d, yyyy");
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }

    private sealed class ContentFormModel
    {
        [Required(ErrorMessage = "Title is required")]
        [StringLength(500, ErrorMessage = "Title cannot exceed 500 characters")]
        public string Title { get; set; } = string.Empty;

        [StringLength(5000, ErrorMessage = "Description cannot exceed 5000 characters")]
        public string? Description { get; set; }

        [Url(ErrorMessage = "Invalid URL format")]
        [StringLength(2000, ErrorMessage = "URL cannot exceed 2000 characters")]
        public string? Url { get; set; }

        public ContentType? ContentType { get; set; }

        public VoteType VoteType { get; set; } = VoteType.Upvote;
    }

    private enum VoteHistoryFilter
    {
        All,
        Upvoted,
        Downvoted
    }
}
