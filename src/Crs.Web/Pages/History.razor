@page "/history"
@using Crs.Core.Enums
@inject AuthService AuthService
@inject FeedService FeedService
@inject NavigationManager Navigation

<PageTitle>Voting History - CRS</PageTitle>

<div class="page-container history-page settings-page">
    <div class="page-header compact-page-header history-page-header">
        <h1>Voting History</h1>
        <div class="history-filter-shell">
            <button class="history-filter-btn"
                    type="button"
                    @onclick="ToggleVoteHistoryFilters"
                    aria-label="Filter voting history"
                    aria-expanded="@_showVoteHistoryFilters"
                    title="@($"Filter voting history: {GetVoteHistoryFilterLabel(_activeVoteHistoryFilter)}")">
                <UiSvgIcon Kind="SvgIconKind.Filter" Class="history-filter-icon" />
            </button>

            @if (_showVoteHistoryFilters)
            {
                <div class="history-filter-menu" role="menu" aria-label="Voting history filter">
                    @foreach (var filter in Enum.GetValues<VoteHistoryFilter>())
                    {
                        <button class="history-filter-option @(_activeVoteHistoryFilter == filter ? "active" : "")"
                                type="button"
                                @onclick="() => SetVoteHistoryFilter(filter)">
                            @GetVoteHistoryFilterLabel(filter)
                        </button>
                    }
                </div>
            }
        </div>
    </div>
    <div class="settings-page-divider"></div>

    @{
        var visibleVoteHistory = GetVisibleVoteHistory();
    }

    @if (!string.IsNullOrWhiteSpace(_voteHistoryError))
    {
        <AlertMessage Variant="AlertVariant.Error">@_voteHistoryError</AlertMessage>
    }

    @if (_isVoteHistoryLoading)
    {
        <LoadingSpinner Title="Loading voting history" Subtitle="Pulling in the content you have voted on so you can review it here." />
    }
    else if (!visibleVoteHistory.Any())
    {
        <EmptyState Message="No voting history yet" />
    }
    else
    {
        <div class="content-table history-list themed-scrollbar">
            @foreach (var content in visibleVoteHistory)
            {
                <ContentRow Class="@(content.VoteType is null ? "history-row vote-cleared" : "history-row")"
                            Title="@content.Title"
                            Url="@content.Url"
                            DateText="@FormatDate(content.ContentDate)"
                            Description="@content.Description"
                            CurrentVote="@content.VoteType"
                            OnVote="voteType => HandleVoteHistoryVote(content.ContentId, voteType)"
                            IsSyncing="@_syncingVoteHistoryContentIds.Contains(content.ContentId)">
                    <MetaContent>
                        <UiBadge Class="content-type-badge">@GetContentTypeDisplay(content.Type)</UiBadge>
                        @if (content.VoteType is null)
                        {
                            <UiBadge Class="preferences-cleared-badge">Vote cleared</UiBadge>
                        }
                    </MetaContent>
                </ContentRow>
            }
        </div>
    }
</div>

@code {
    private readonly List<VoteHistoryItem> _voteHistory = new();
    private readonly Dictionary<Guid, VoteType> _serverVoteHistoryStates = new();
    private readonly HashSet<Guid> _syncingVoteHistoryContentIds = new();
    private readonly Dictionary<Guid, VoteType?> _desiredVoteHistoryStates = new();
    private readonly Dictionary<Guid, DateTime> _lastVoteHistoryActionAt = new();
    private readonly HashSet<Guid> _sessionClearedVoteHistoryContentIds = new();
    private static readonly TimeSpan VoteHistoryActionDebounceWindow = TimeSpan.FromMilliseconds(400);
    private bool _isVoteHistoryLoading = true;
    private bool _showVoteHistoryFilters;
    private string? _voteHistoryError;
    private VoteHistoryFilter _activeVoteHistoryFilter = VoteHistoryFilter.All;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.EnsureAuthenticatedAsync())
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadVoteHistoryAsync();
    }

    private async Task LoadVoteHistoryAsync()
    {
        _isVoteHistoryLoading = true;
        _voteHistoryError = null;
        _showVoteHistoryFilters = false;
        _voteHistory.Clear();
        _serverVoteHistoryStates.Clear();
        _desiredVoteHistoryStates.Clear();
        _syncingVoteHistoryContentIds.Clear();
        _lastVoteHistoryActionAt.Clear();
        _sessionClearedVoteHistoryContentIds.Clear();

        var history = await FeedService.GetVoteHistoryAsync();
        foreach (var item in history.OrderByDescending(GetVoteHistorySortDate))
        {
            _voteHistory.Add(item);
            if (item.VoteType is { } voteType)
            {
                _serverVoteHistoryStates[item.ContentId] = voteType;
            }
        }

        _isVoteHistoryLoading = false;
    }

    private void ToggleVoteHistoryFilters()
    {
        _showVoteHistoryFilters = !_showVoteHistoryFilters;
    }

    private void SetVoteHistoryFilter(VoteHistoryFilter filter)
    {
        _activeVoteHistoryFilter = filter;
        _showVoteHistoryFilters = false;
    }

    private Task HandleVoteHistoryVote(Guid contentId, VoteType voteType)
    {
        if (_lastVoteHistoryActionAt.TryGetValue(contentId, out var lastActionAt) &&
            DateTime.UtcNow - lastActionAt < VoteHistoryActionDebounceWindow)
        {
            return Task.CompletedTask;
        }

        var historyItem = _voteHistory.FirstOrDefault(item => item.ContentId == contentId);
        if (historyItem == null)
        {
            return Task.CompletedTask;
        }

        _voteHistoryError = null;
        _lastVoteHistoryActionAt[contentId] = DateTime.UtcNow;

        var currentVote = historyItem.VoteType;
        VoteType? nextVote = currentVote == voteType ? null : voteType;

        historyItem.VoteType = nextVote;
        if (nextVote is null)
        {
            _sessionClearedVoteHistoryContentIds.Add(contentId);
        }
        else
        {
            _sessionClearedVoteHistoryContentIds.Remove(contentId);
        }

        _desiredVoteHistoryStates[contentId] = nextVote;

        if (!_syncingVoteHistoryContentIds.Contains(contentId))
        {
            _ = SyncVoteHistoryStateAsync(contentId);
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SyncVoteHistoryStateAsync(Guid contentId)
    {
        _syncingVoteHistoryContentIds.Add(contentId);

        try
        {
            while (_desiredVoteHistoryStates.TryGetValue(contentId, out var desiredVoteState))
            {
                var previousServerVoteState = _serverVoteHistoryStates.TryGetValue(contentId, out var serverVote)
                    ? serverVote
                    : (VoteType?)null;

                var succeeded = await PersistVoteHistoryStateAsync(contentId, desiredVoteState);
                if (!succeeded)
                {
                    ApplyVoteHistoryState(contentId, previousServerVoteState);
                    _desiredVoteHistoryStates[contentId] = previousServerVoteState;
                    _voteHistoryError = "We couldn't update that vote. Please try again.";
                    break;
                }

                if (desiredVoteState is { } persistedVote)
                {
                    _serverVoteHistoryStates[contentId] = persistedVote;
                    _sessionClearedVoteHistoryContentIds.Remove(contentId);
                }
                else
                {
                    _serverVoteHistoryStates.Remove(contentId);
                    _sessionClearedVoteHistoryContentIds.Add(contentId);
                }

                if (_desiredVoteHistoryStates.TryGetValue(contentId, out var latestDesiredState) &&
                    latestDesiredState == desiredVoteState)
                {
                    _desiredVoteHistoryStates.Remove(contentId);
                }
            }
        }
        finally
        {
            _syncingVoteHistoryContentIds.Remove(contentId);
            StateHasChanged();
        }
    }

    private async Task<bool> PersistVoteHistoryStateAsync(Guid contentId, VoteType? desiredVoteState)
    {
        var historyItem = _voteHistory.FirstOrDefault(item => item.ContentId == contentId);
        if (historyItem == null)
        {
            return false;
        }

        if (desiredVoteState is null)
        {
            return await FeedService.RemoveVoteAsync(contentId);
        }

        var result = await FeedService.VoteAsync(contentId, desiredVoteState.Value);
        if (result == null)
        {
            return false;
        }

        if (_desiredVoteHistoryStates.TryGetValue(contentId, out var latestDesiredState) && latestDesiredState == desiredVoteState)
        {
            historyItem.VoteType = result.VoteType;
            historyItem.VoteCreatedAt = result.CreatedAt;
            historyItem.VoteUpdatedAt = result.UpdatedAt;
        }

        return true;
    }

    private void ApplyVoteHistoryState(Guid contentId, VoteType? voteState)
    {
        var historyItem = _voteHistory.FirstOrDefault(item => item.ContentId == contentId);
        if (historyItem == null)
        {
            return;
        }

        historyItem.VoteType = voteState;
        if (voteState is null)
        {
            _sessionClearedVoteHistoryContentIds.Add(contentId);
            return;
        }

        _sessionClearedVoteHistoryContentIds.Remove(contentId);
    }

    private List<VoteHistoryItem> GetVisibleVoteHistory()
    {
        return _voteHistory
            .Where(ShouldShowVoteHistoryItem)
            .OrderByDescending(GetVoteHistorySortDate)
            .ToList();
    }

    private bool ShouldShowVoteHistoryItem(VoteHistoryItem item)
    {
        if (item.VoteType is null)
        {
            return _sessionClearedVoteHistoryContentIds.Contains(item.ContentId);
        }

        return _activeVoteHistoryFilter switch
        {
            VoteHistoryFilter.Upvoted => item.VoteType == VoteType.Upvote,
            VoteHistoryFilter.Downvoted => item.VoteType == VoteType.Downvote,
            _ => true
        };
    }

    private static string GetVoteHistoryFilterLabel(VoteHistoryFilter filter)
    {
        return filter switch
        {
            VoteHistoryFilter.Upvoted => "Upvoted",
            VoteHistoryFilter.Downvoted => "Downvoted",
            _ => "All"
        };
    }

    private static DateTime GetVoteHistorySortDate(VoteHistoryItem item)
    {
        return item.VoteUpdatedAt ?? item.VoteCreatedAt;
    }

    private static string GetContentTypeDisplay(ContentType type) => type switch
    {
        ContentType.BlogPost => "Blog Post",
        _ => type.ToString()
    };

    private static string FormatDate(DateTime dateTime)
    {
        var local = dateTime.ToLocalTime();
        return local.ToString("MMM d, yyyy");
    }

    private enum VoteHistoryFilter
    {
        All,
        Upvoted,
        Downvoted
    }
}
