@page "/"
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Welcome - CRS</PageTitle>

<div class="landing-container">
  <div class="landing-grid">
    <section class="landing-card landing-copy-card">
      <p class="landing-eyebrow">Content Recommendation System</p>
      <h1 class="landing-title">Welcome</h1>
      <p class="landing-description">
        Sign in to discover papers, videos, blogs, and more from your favorite sources,
        all in one private personalized feed.
      </p>
    </section>

    <section class="landing-card landing-auth-card">
      <p class="landing-eyebrow">Sign in</p>

      @if (!string.IsNullOrEmpty(_errorMessage))
      {
        <AlertMessage Variant="AlertVariant.Error">@_errorMessage</AlertMessage>
      }

      <div @ref="_formHost">
        <EditForm Model="@_model" OnSubmit="HandleLogin" method="post" class="landing-login-form">
          <DataAnnotationsValidator />

          <div class="form-group">
            <label for="home-email">Email</label>
            <input id="home-email"
                   class="form-input"
                   type="email"
                   name="email"
                   autocomplete="username"
                   autocapitalize="none"
                   autocorrect="off"
                   spellcheck="false"
                   inputmode="email"
                   placeholder="you@example.com"
                   @oninput="OnEmailInput" />
            <ValidationMessage For="@(() => _model.Email)" />
          </div>

          <div class="form-group">
            <label for="home-password">Password</label>
            <input id="home-password"
                   class="form-input"
                   type="password"
                   name="password"
                   autocomplete="current-password"
                   autocapitalize="none"
                   autocorrect="off"
                   spellcheck="false"
                   placeholder="••••••••"
                   @oninput="OnPasswordInput" />
            <ValidationMessage For="@(() => _model.Password)" />
          </div>

          <button type="submit" class="btn-primary landing-submit" disabled="@_isLoading">
            @(_isLoading ? "Working..." : "Sign in")
          </button>
        </EditForm>
      </div>

      @if (ShowDevelopmentLogin)
      {
        <button type="button" class="btn-secondary landing-dev-login" @onclick="HandleDevelopmentLogin" disabled="@_isLoading">
          Use development login
        </button>
      }

    </section>
    </div>
</div>

@code {
  private LoginModel _model = new();
  private string? _errorMessage;
  private bool _isLoading;
  private ElementReference _formHost;
  private bool ShowDevelopmentLogin => AuthService.IsDevelopmentLoginEnabled || IsLocalBrowser();

  protected override async Task OnInitializedAsync()
  {
    if (await AuthService.EnsureAuthenticatedAsync())
    {
      Navigation.NavigateTo("/feeds");
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    try
    {
      await JSRuntime.InvokeVoidAsync("authForm.watchAutofill", _formHost);
    }
    catch (JSException)
    {
    }
    catch (JSDisconnectedException)
    {
    }
  }

  private void OnEmailInput(ChangeEventArgs args)
  {
    _model.Email = args.Value?.ToString() ?? string.Empty;
  }

  private void OnPasswordInput(ChangeEventArgs args)
  {
    _model.Password = args.Value?.ToString() ?? string.Empty;
  }

  private async Task HandleLogin(EditContext editContext)
  {
    await SyncCredentialsFromDomAsync(editContext);
    if (!editContext.Validate())
    {
      return;
    }

    _isLoading = true;
    _errorMessage = null;

    var result = await AuthService.LoginAsync(_model.Email, _model.Password);

    if (result.Success)
    {
      Navigation.NavigateTo("/feeds");
    }
    else
    {
      _errorMessage = result.ErrorMessage;
    }

    _isLoading = false;
  }

  private async Task SyncCredentialsFromDomAsync(EditContext editContext)
  {
    try
    {
      var fields = await JSRuntime.InvokeAsync<LoginDomFields>("authForm.readFields", _formHost);
      var (email, password) = AutofillCredentials.PreferDom(
          _model.Email,
          _model.Password,
          fields.Email,
          fields.Password);

      if (email != _model.Email)
      {
        _model.Email = email;
        editContext.NotifyFieldChanged(editContext.Field(nameof(LoginModel.Email)));
      }

      if (password != _model.Password)
      {
        _model.Password = password;
        editContext.NotifyFieldChanged(editContext.Field(nameof(LoginModel.Password)));
      }
    }
    catch (JSException)
    {
    }
    catch (JSDisconnectedException)
    {
    }
  }

  private async Task HandleDevelopmentLogin()
  {
    _isLoading = true;
    _errorMessage = null;

    var result = await AuthService.UseDevelopmentLoginAsync();
    if (result.Success)
    {
      Navigation.NavigateTo("/feeds");
    }
    else
    {
      _errorMessage = result.ErrorMessage;
    }

    _isLoading = false;
  }

  private bool IsLocalBrowser()
  {
    if (!Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri))
    {
      return false;
    }

    return uri.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase) ||
           uri.Host.Equals("127.0.0.1", StringComparison.OrdinalIgnoreCase) ||
           uri.Host.Equals("[::1]", StringComparison.OrdinalIgnoreCase);
  }

  private sealed class LoginDomFields
  {
    public string Email { get; set; } = string.Empty;
    public string Password { get; set; } = string.Empty;
  }

  private class LoginModel
  {
    [Required(ErrorMessage = "Email is required")]
    [EmailAddress(ErrorMessage = "Invalid email address")]
    public string Email { get; set; } = string.Empty;

    [Required(ErrorMessage = "Password is required")]
    public string Password { get; set; } = string.Empty;
  }
}
