@page "/"
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Welcome - CRS</PageTitle>

<div class="landing-container">
  <div class="landing-content">
    <h1 class="landing-title">Content Recommendation System</h1>
    <p class="landing-description">
      Discover papers, videos, blogs, and more from your favorite sources,
      all in one place with personalized recommendations.
    </p>
    <div class="landing-actions">
      <a href="/signup" class="btn-primary btn-large">Get Started</a>
      <a href="/login" class="btn-secondary btn-large">Sign In</a>
    </div>
  </div>
</div>

@code {
  protected override async Task OnInitializedAsync()
  {
    if (await AuthService.EnsureAuthenticatedAsync())
    {
      Navigation.NavigateTo("/feeds");
    }
  }
}
