@page "/feeds"
@using Microsoft.AspNetCore.Components.Web
@using Crs.Core.Enums
@inject AuthService AuthService
@inject FeedService FeedService
@inject SourceService SourceService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>My Feed - CRS</PageTitle>

<div class="page-container">
    <UiPageHeader Title="Feeds" Class="compact-page-header" />
    <div class="settings-page-divider"></div>

    <div class="feed-container">
        @if (_content == null)
        {
            <LoadingSpinner Title="Building your feed" Subtitle="Pulling in recommendations and recent activity for you." />
        }
        else if (!_content.Any())
        {
            @if (_sources == null)
            {
                <LoadingSpinner Title="Checking your sources" Subtitle="Verifying which sources you have connected." />
            }
            else if (!string.IsNullOrEmpty(_sourcesLoadError))
            {
                <EmptyState Title="Couldn't Load Your Sources"
                            Message="@_sourcesLoadError"
                            SecondaryMessage="Once your sources load successfully, we'll be able to show the right next step here.">
                    <a href="/sources" class="btn-primary">Go To Sources</a>
                </EmptyState>
            }
            else if (!_sources.Any())
            {
                <EmptyState Title="No Sources Yet"
                            Message="Start by adding some learning sources like RSS feeds, YouTube channels, or blogs."
                            SecondaryMessage="Our system will automatically fetch content daily and show personalized recommendations here.">
                    <a href="/sources" class="btn-primary">Add Your First Source</a>
                </EmptyState>
            }
            else
            {
                <EmptyState Title="Processing Your Sources"
                            Message="@($"You have {_sources.Count} source{(_sources.Count == 1 ? "" : "s")} configured. Our system is working on fetching and analyzing content.")"
                            SecondaryMessage="This process runs automatically every 24 hours. Check back soon for personalized recommendations!">
                    <a href="/sources" class="btn-primary">Manage Sources</a>
                </EmptyState>
            }
        }

        <div class="feed-sections">
            @if (_content != null && _content.Any())
            {
                @foreach (var type in Enum.GetValues<ContentType>())
                {
                    var contentOfType = _contentByType.ContainsKey(type) ? _contentByType[type] : new List<ContentItem>();

                    @if (contentOfType.Any())
                    {
                        <div class="feed-section">
                            <UiSectionHeader Title="@DisplayFormatters.ContentTypeLabel(type)" />
                            <div class="content-table">
                                @foreach (var content in contentOfType)
                                {
                                    <ContentRow Title="@content.Title"
                                                Url="@content.Url"
                                                DateText="@DisplayFormatters.RelativeDate(content.PublishedAt)"
                                                Description="@content.Description"
                                                CurrentVote="@_voteSync.GetVoteState(content.Id)"
                                                OnVote="voteType => _voteSync.HandleVote(content.Id, voteType)"
                                                IsSyncing="@_voteSync.IsSyncing(content.Id)" />
                                }
                            </div>
                        </div>
                    }
                }
            }

            <XFeedSection />
        </div>
    </div>
</div>

@code {
    private List<ContentItem>? _content;
    private List<SourceItem>? _sources;
    private string? _sourcesLoadError;
    private Dictionary<ContentType, List<ContentItem>> _contentByType = new();
    private VoteSyncCoordinator _voteSync = default!;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.EnsureAuthenticatedAsync())
        {
            Navigation.NavigateTo("/");
            return;
        }

        _voteSync = new VoteSyncCoordinator(
            async (contentId, voteType) => (await FeedService.VoteAsync(contentId, voteType))?.VoteType,
            contentId => FeedService.RemoveVoteAsync(contentId),
            StateHasChanged);

        AuthService.OnAuthStateChanged += HandleAuthStateChanged;
        await LoadFeed();
    }

    private async Task LoadFeed()
    {
        _content = await FeedService.GetFeedAsync(null);

        // Group content by type
        if (_content != null && _content.Any())
        {
            _contentByType = _content
                .GroupBy(r => r.Type)
                .ToDictionary(g => g.Key, g => g.ToList());

            // Load user votes for all content
            await LoadUserVotes();
        }
        else
        {
            _contentByType = new Dictionary<ContentType, List<ContentItem>>();
        }

        // Only check for sources if we have no content to show appropriate message
        if (_content == null || !_content.Any())
        {
            var sourcesResult = await SourceService.GetUserSourcesResultAsync();
            _sources = sourcesResult.Sources;
            _sourcesLoadError = sourcesResult.IsSuccess ? null : sourcesResult.ErrorMessage;
        }
        else
        {
            _sourcesLoadError = null;
        }

        StateHasChanged();
    }

    private async Task LoadUserVotes()
    {
        if (_content == null) return;

        var votes = await FeedService.GetUserVotesAsync();
        _voteSync.SetServerVotes(votes);
    }

    private void HandleAuthStateChanged()
    {
        if (!AuthService.CurrentState.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}
